# Postgres connection string. A free instance from Supabase (supabase.com) or Neon (neon.tech)
# works fine — grab the "connection string" / "connection pooling" URI they give you.
# Same value works locally and when pasted into Streamlit Community Cloud's Secrets settings.
DATABASE_URL=

OPENROUTER_API_KEY=

# Text generation (content + outreach). Override to any OpenRouter model slug.
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# AI-generated (non-templated) infographics only — optional, templated infographics need no key.
# Pick which provider draws them: "openrouter" (default) or "anthropic".
# IMAGE_GEN_PROVIDER=openrouter

# openrouter provider: uses the same OPENROUTER_API_KEY above. Required if you use this
# provider: pick a slug from https://openrouter.ai/models?output_modalities=image (check
# licensing there for open-weight).
# IMAGE_GEN_MODEL=

# anthropic provider: Claude has no native image-generation endpoint, so it draws the
# illustration itself with matplotlib/Pillow via the code execution tool. Slower and less
# photorealistic than a dedicated image model, but needs no separate image-model subscription.
# ANTHROPIC_API_KEY=
# ANTHROPIC_IMAGE_MODEL=claude-opus-5
